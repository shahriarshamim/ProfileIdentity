@model ProfileIdentity.ViewModels.UserProfile

<h2>My Profile</h2>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Profile Picture</label>
        <input asp-for="Pic"
               type="file"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

</form>