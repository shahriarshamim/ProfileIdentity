@model ProfileIdentity.ViewModels.UserProfile
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="mb-4">My Profile</h2>
        <img src="@Model.ProfilePicPath" alt="Profile picture" width="180" height="180" class="rounded-circle object-fit-cover border mb-3" />
        <h3>@(string.IsNullOrWhiteSpace(Model.Name) ? "No name set" : Model.Name)</h3>
        <a asp-action="Create" class="btn btn-primary mt-3">Edit Profile</a>
    </div>
</div>
